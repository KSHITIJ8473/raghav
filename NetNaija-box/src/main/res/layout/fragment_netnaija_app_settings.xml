<?xml version="1.0" encoding="utf-8"?>
<!-- inline resource refs resolve against the host app table on inflation, so
     every drawable is set from plugin resources in code instead -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="26dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NETNAIJA-BOX"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#FF2E3B"
        android:letterSpacing="0.24" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Settings"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FAFAFB" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp"
        android:text="Server and playback options"
        android:textSize="12.5sp"
        android:textColor="#8F8F98" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="6dp"
        android:text="SERVER &amp; API"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:textColor="#6E6E78"
        android:letterSpacing="0.14" />

    <LinearLayout
        android:id="@+id/hostRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:focusable="true"
        android:clickable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API Host"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="#F4F4F6" />

            <TextView
                android:id="@+id/hostSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="#8F8F98" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chevron_host"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:alpha="0.6"
            android:contentDescription="Select host" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="6dp"
        android:text="PLAYBACK"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:textColor="#6E6E78"
        android:letterSpacing="0.14" />

    <LinearLayout
        android:id="@+id/sourcesRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:focusable="true"
        android:clickable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sources"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="#F4F4F6" />

            <TextView
                android:id="@+id/sourcesSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="#8F8F98" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chevron_sources"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:alpha="0.6"
            android:contentDescription="Select sources" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="6dp"
        android:text="HOME PAGE"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:textColor="#6E6E78"
        android:letterSpacing="0.14" />

    <LinearLayout
        android:id="@+id/sectionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:focusable="true"
        android:clickable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home Sections"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textColor="#F4F4F6" />

            <TextView
                android:id="@+id/sectionsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="#8F8F98" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chevron_sections"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:alpha="0.6"
            android:contentDescription="Reorder home sections" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/saveContainer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:focusable="true"
        android:clickable="true">

        <ImageView
            android:id="@+id/saveIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Save" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Save &amp; Reload"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Changes are applied after the app restarts"
        android:textSize="10.5sp"
        android:textColor="#5C5C66" />
</LinearLayout>
